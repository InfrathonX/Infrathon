# miles_diffusion Wan2.2 DanceGRPO agent run: a Codex model, 6 h, on two leased GPU pairs (Work's and the Judge's).
# Copy to codex.env (mode 0600, not committed) and run:  launch/miles-diffusion-wan/run.sh --config <env> --run-id <id>
# Host locations are read from the host config (launch/mlsysforge.env; see scripts/miles_common/host_config.py show)
# and may also be set here: MDWAN_ASSETS (Wan2.2-TI2V-5B, HPSv3, Qwen2-VL-7B config, and video_prompts/test.txt of
# Hao7/video_prompts@bc7d7a44: the quality eval's prompts, which build_images.sh sha256-checks and bakes into the Judge
# image), MDWAN_PUBLIC_DATA and
# MDWAN_PRIVATE_DATA (data roots in the Judge layout, scripts/miles_diffusion_wan/judge/make_private.py; the private
# root mode 0700 and owned by a uid other than the container agent's 1001), MILES_SCRATCH_ROOT (runs and container
# scratch, never on the host root disk) and MDWAN_CPU_CORES (physical cores local to the pair; unset = 24; the timed
# window T depends on it). A formal run reads the private root's qualification.json, so start
# it as a user that can read the private root.
SFORGE_VERSION_STORE_ROOT=<path to the SForge version store>
CODEX_CLI_VERSION=0.159.3
SFORGE_AGENT_RUNTIME_DIR=<path to agent_runtimes>/codex-0.159.3
MODEL=<model id>
CODEX_AUTH_JSON_PATH=<path to a mode-0600 auth.json>
REASONING_EFFORT=max
TASK_TIMEOUT=86400
SUBMISSION_COOLDOWN=300
# Work's GPU pair and the Judge's own pair: two NVLink pairs, four distinct GPUs; Work keeps running while a Judge
# measures. JUDGE_GPU_INDICES=shared (or run.sh --shared-gpus) runs the Judge on GPU_INDICES and pauses Work for each
# Judge round; run.sh --judge-gpus C,D overrides JUDGE_GPU_INDICES. The run holds all four GPUs until it ends.
GPU_INDICES=0,1
JUDGE_GPU_INDICES=2,3
# The host Judge port.
JUDGE_PORT=18633
# Optional: Work's physical cores (MDWAN_CPU_CORES of them, local to GPU_INDICES; default: the first ones local to the
# pair) and, with a separate Judge pair, the Judge's (local to JUDGE_GPU_INDICES; default: the first ones local to the
# Judge pair that CPUSET does not use). The two must not overlap; the timed window T depends on these cores.
#CPUSET=<physical cores local to GPU_INDICES>
#JUDGE_CPUSET=<physical cores local to JUDGE_GPU_INDICES>
