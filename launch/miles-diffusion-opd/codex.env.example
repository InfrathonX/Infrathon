# miles_diffusion SD3.5-M DiffusionOPD agent run with a Codex model on a Codex ChatGPT login.
# Copy to codex.env (not committed) and point CODEX_AUTH_JSON_PATH at a mode-0600 auth.json.
# Host locations are read from the host config (launch/mlsysforge.env; see
# scripts/miles_common/host_config.py show) and may also be set here: MDOPD_ASSETS (SD3.5-M weights and
# teachers), MDOPD_V2_ROOT (scorers/, public-02/root whose probe/ and replay/ recordings are mounted into Work, and
# private-02: the Judge's private root, mode 0700, owned by a uid other than the container agent's 1001, mounted
# read-only into the Judge only; or MDOPD_V2_SCORERS / MDOPD_V2_PUBLIC_DATA / MDOPD_V2_PRIVATE_DATA one by one),
# the mandatory LLM integrity review's SFORGE_LLM_JUDGE_* settings, MILES_SCRATCH_ROOT (Work / Judge scratch,
# tens to hundreds of GB per run, never on the host root disk) and MDOPD_CPU_CORES (physical cores local to each
# pair; unset = 24; the timed window T depends on it).
SFORGE_VERSION_STORE_ROOT=<path to the SForge version store>
# Codex CLI: the host runtime mounted read-only into Work (built with launch/build-agent-runtime.sh).
CODEX_CLI_VERSION=0.159.3
SFORGE_AGENT_RUNTIME_DIR=<path to agent_runtimes>/codex-0.159.3
# ChatGPT login: Codex reaches the OpenAI hosts through the run relay's allowlisted CONNECT proxy.
MODEL=<model id>
CODEX_AUTH_JSON_PATH=<path to a mode-0600 auth.json>
REASONING_EFFORT=max
# Budget and pacing (one Judge takes ~62 min on the reference; it pauses Work only with JUDGE_GPU_INDICES=shared).
TASK_TIMEOUT=86400
SUBMISSION_COOLDOWN=300
# Work's GPU pair and the Judge's own pair: two NVLink pairs, four distinct GPUs; Work keeps running while a Judge
# measures. JUDGE_GPU_INDICES=shared (or run.sh --shared-gpus) runs the Judge on GPU_INDICES and pauses Work for each
# Judge round; run.sh --judge-gpus C,D overrides JUDGE_GPU_INDICES. The run holds all four GPUs until it ends.
GPU_INDICES=0,1
JUDGE_GPU_INDICES=2,3
# The host Judge port.
JUDGE_PORT=18632
# Optional: Work's physical cores (MDOPD_CPU_CORES of them, local to GPU_INDICES; default: the first ones local to the
# pair) and, with a separate Judge pair, the Judge's (local to JUDGE_GPU_INDICES; default: the first ones local to the
# Judge pair that CPUSET does not use). The two must not overlap; the timed window T depends on these cores.
#CPUSET=<physical cores local to GPU_INDICES>
#JUDGE_CPUSET=<physical cores local to JUDGE_GPU_INDICES>
