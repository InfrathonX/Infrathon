# Miles OPCD agent run with a Codex model on a Codex ChatGPT login.
# Copy to codex.env (not committed) and point CODEX_AUTH_JSON_PATH at a mode-0600 auth.json.
# Host locations (Miles checkout, assets, model cache, scratch) are read from the host config
# (launch/mlsysforge.env: MILES_DATA_ROOT, MILES_SCRATCH_ROOT, ...; see
# scripts/miles_common/host_config.py show); any of them may also be set here.
SFORGE_VERSION_STORE_ROOT=<path to the SForge version store>
# Codex CLI: the host runtime mounted read-only into Work (built with launch/build-agent-runtime.sh).
CODEX_CLI_VERSION=0.159.3
SFORGE_AGENT_RUNTIME_DIR=<path to agent_runtimes>/codex-0.159.3
# ChatGPT login: Codex reaches the OpenAI hosts through the run relay's allowlisted CONNECT proxy.
MODEL=<model id>
CODEX_AUTH_JSON_PATH=<path to a mode-0600 auth.json>
REASONING_EFFORT=max
# Budget and pacing.
TASK_TIMEOUT=86400
SUBMISSION_COOLDOWN=300
# Work's GPU pair and the Judge's own pair: two NVLink pairs, four distinct GPUs; Work keeps running while a Judge
# measures. JUDGE_GPU_INDICES=shared (or run.sh --shared-gpus) runs the Judge on GPU_INDICES and pauses Work for each
# Judge round; run.sh --judge-gpus C,D overrides JUDGE_GPU_INDICES. The run holds all four GPUs until it ends.
GPU_INDICES=0,1
JUDGE_GPU_INDICES=2,3
# The host Judge port.
JUDGE_PORT=18634
