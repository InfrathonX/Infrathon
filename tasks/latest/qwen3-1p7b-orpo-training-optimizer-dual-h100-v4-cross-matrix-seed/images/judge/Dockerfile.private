# Private Judge layer: the public Judge plus private_data/, then the
# protected-file check that covers it.  Built only on the host that runs the
# task, never published; private_data/ comes from the Judge-only build context
# scripts/build_images.sh stages.  Modes match the earlier single-file Judge.
ARG JUDGE_PUBLIC_IMAGE
FROM ${JUDGE_PUBLIC_IMAGE}

COPY --from=private_data . /opt/orpo_judge/private_data/

RUN chown -R root:root /opt/orpo_judge/private_data \
    && chmod 700 /opt/orpo_judge/private_data \
    && find /opt/orpo_judge/private_data -type f -exec chmod 600 {} + \
    && python /opt/orpo_judge/verifier/verify_orpo.py --verify-protected-files
