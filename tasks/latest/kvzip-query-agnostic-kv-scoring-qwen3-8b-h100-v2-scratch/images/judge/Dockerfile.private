# Private Judge layer: the public Judge plus the private holdout.  Built only on
# the host that runs the task, never published; the files come from the
# Judge-only build context scripts/build_images.sh stages.
# The released-checkpoint fingerprint holds digests and row sketches, no weights
# (scripts/prepare_released_weights_fingerprint.py).
ARG JUDGE_PUBLIC_IMAGE
FROM ${JUDGE_PUBLIC_IMAGE}
COPY --from=final_items final_manifest.json final_items.jsonl.gz released_weights_fingerprint.pt /opt/kvzip_kv_scoring_judge/private/
RUN chown -R root:root /opt/kvzip_kv_scoring_judge/private \
 && chmod 0500 /opt/kvzip_kv_scoring_judge/private \
 && chmod 0400 /opt/kvzip_kv_scoring_judge/private/final_manifest.json /opt/kvzip_kv_scoring_judge/private/final_items.jsonl.gz /opt/kvzip_kv_scoring_judge/private/released_weights_fingerprint.pt
