  "role": "final",
  "run_gates": ["release_calibrated", "source_admission", "candidate_isolation", "own_device_only", "hardware_envelope", "frozen_bf16_kv_bytes", "cumulative_kv_bytes", "frame_shape", "mean_psnr", "mean_ssim", "mean_lpips", "mean_vbench_aesthetic_quality", "mean_vbench_background_consistency", "mean_vbench_image_quality", "mean_vbench_subject_consistency", "case_psnr", "case_ssim", "case_lpips", "case_vbench_aesthetic_quality", "case_vbench_background_consistency", "case_vbench_image_quality", "case_vbench_subject_consistency", "case_wall_time"],
  "same_suite_for_interactive_and_final": true,
  "schema_version": 1,
  "selection_semantics": "the 17 hidden cases run under one admitted source, spread over 1-8 identical Judge devices (static heaviest-first plan; a device runs its cases one after another, each case's generation then its fidelity and VBench metrics); per workload the case-mean gates, and on every case the per-case floor gates and the wall budget, must pass; score = sqrt(longcat_ratio x (1 + longcat_q) x hy_worldplay_8b_ratio x (1 + hy_worldplay_8b_q)) with each ratio pooled over the workload's cases and each q from its case means; an uncalibrated release records every reading and returns valid=false",
  "suite_gate_timeouts": {
    "case_overhead_seconds": 120,
    "controller_overhead_seconds": 300,
    "controller_seconds": 8720,
    "max_gpu_count": 8,
    "min_gpu_count": 1,
    "start_stagger_seconds": 20,
    "workloads": {
      "hy_worldplay_8b": {
        "fidelity_metric_seconds": 600,
        "stage_seconds": 1500,
        "vbench_metric_seconds": 900
      },
      "longcat": {
        "fidelity_metric_seconds": 600,
        "stage_seconds": 4500,
        "vbench_metric_seconds": 1200
      }
    }
  },
  "suite_id": "quant-videogen-hidden-v4",
  "timeout_semantics": "stage and metric budgets are per-model deployment budgets enforced by the controller on every device inside the envelope, not device measurements; controller_seconds is the bound on max_gpu_count devices (every case at its full budget, list-scheduled heaviest first with staggered starts) and grows when fewer devices are given",
  "weight_semantics": "within a workload the cases are pooled by bytes: ratio = sum of bf16_kv_bytes / sum of stored_kv_bytes over the workload's cases, so a case's weight is its share of those sums (1/case count while, as here, every case of a workload has the same shape-determined BF16 byte count); the two quality-weighted workload ratios enter the score as a geometric mean (workload_exponents)",
  "workload_exponents": {
