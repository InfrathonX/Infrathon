+++ b/task_entry.py
@@ -0,0 +1,322 @@
+"""Task entry points for the Wan2.2-TI2V-5B DanceGRPO + HPSv3 task (reference implementation).
+
+  python task_entry.py score --videos V.npz --prompts P.jsonl --out O
+  python task_entry.py run   --contract C.json --out O
+  python task_entry.py serve --contract C.json --ctl CTL_FIFO --events EV_FIFO --out O
+
+``run`` is the audited real RL (R rounds x P prompts x n samples, one publication per round).
+``serve`` is the long-lived fixed-replay trainer: it attaches to externally launched engines and answers
+``probe`` / ``replay`` / ``dump_master`` / ``reset`` / ``stop`` messages (one JSON object per line on CTL_FIFO,
+answers on EV_FIFO).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import shutil
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parent
+CLEAN_ENGINE = os.environ.get("WAN_CLEAN_ENGINE_PYTHON", "/sgl-workspace/sglang/python")
+
+
+# ------------------------------------------------------------------------------------------------ helpers
+
+
+def _log(msg: str) -> None:
+    print(f"[task_entry {time.strftime('%H:%M:%S')}] {msg}", flush=True)
+
+
+def merged_engine_python(contract: dict, scratch: Path) -> str:
+    """Engine source = clean sglang + repo/engine_overlay (whitelisted files). The Judge may pass a prebuilt path."""
+    if contract.get("engine_python_path"):
+        return contract["engine_python_path"]
+    dst = scratch / "engine_python"
+    if not dst.exists():
+        shutil.copytree(CLEAN_ENGINE, dst, symlinks=True)
+        overlay = REPO / "engine_overlay"
+        if overlay.exists():
+            for f in overlay.rglob("*.py"):
+                rel = f.relative_to(overlay)
+                target = dst / "sglang" / "multimodal_gen" / rel
+                target.parent.mkdir(parents=True, exist_ok=True)
+                shutil.copy2(f, target)
+    return str(dst)
+
+
+def start_ray(num_gpus: int = 2) -> None:
+    subprocess.run("ray stop --force >/dev/null 2>&1; true", shell=True)
+    subprocess.run(
+        ["ray", "start", "--head", "--node-ip-address", "127.0.0.1", f"--num-gpus={num_gpus}",
+         "--disable-usage-stats", "--include-dashboard=false", f"--object-store-memory={32 * 2**30}"],
+        check=True,
+    )
+
+
+def common_md_args(c: dict) -> list[str]:
+    s, o = c["sampling"], c["optim"]
+    return [
+        "--hf-checkpoint", c["model"],
+        "--train-backend", "fsdp", "--fsdp-master-dtype", "fp32", "--fsdp-reduce-dtype", "fp32",
+        "--diffusion-forward-dtype", "bf16", "--update-weight-target-module", "transformer",
+        "--diffusion-num-steps", str(s["steps"]), "--diffusion-guidance-scale", str(s["guidance"]),
+        "--diffusion-true-cfg-scale", str(s["guidance"]), "--diffusion-negative-prompt", s["negative_prompt"],
+        "--diffusion-height", str(s["height"]), "--diffusion-width", str(s["width"]),
+        "--diffusion-output-num-frames", str(s["num_frames"]), "--diffusion-flow-shift", str(s["flow_shift"]),
+        "--diffusion-noise-level", str(s["eta"]), "--diffusion-sde-type", "dance",
+        "--diffusion-num-sde-steps", str(s["window_size"]),
+        "--diffusion-sde-window-range", f"{s['window_range'][0]},{s['window_range'][1]}",
+        "--diffusion-recompute-old-log-prob",
+        "--advantage-estimator", "grpo", "--globalize-reward-std",
+        "--diffusion-clip-range", str(o["clip_range"]), "--diffusion-adv-clip-max", str(o["adv_clip"]),
+        "--diffusion-kl-beta", "0.0",
+        "--lr", str(o["lr"]), "--weight-decay", str(o["weight_decay"]),
+        "--adam-beta1", str(o["betas"][0]), "--adam-beta2", str(o["betas"][1]), "--adam-eps", str(o["eps"]),
+        "--clip-grad", str(o["grad_clip"]),
+        "--rm-type", "hpsv3", "--hpsv3-checkpoint-path", c["hpsv3_checkpoint"],
+        "--hpsv3-base-config-path", c["hpsv3_base"], "--hpsv3-reward-colocate", "--hpsv3-num-workers", "2",
+        "--hpsv3-batch-size", "4", "--hpsv3-frame-batch-size", "16",
+        "--rollout-video-dtype", "uint8",
+        "--rollout-microgroup-size", "1", "--micro-batch-size-sample", "1", "--micro-batch-size-tstep", "1",
+        "--diffusion-train-iter-order", "sample_major",
+        "--update-weight-buffer-size", str(4 * 2**30),
+        "--actor-num-nodes", "1", "--actor-num-gpus-per-node", "2", "--rollout-num-gpus", "2",
+        "--rollout-num-gpus-per-engine", "1", "--num-gpus-per-node", "2", "--colocate",
+        "--use-miles-router", "--sglang-server-concurrency", "2",
+        "--rollout-health-check-interval", "60", "--miles-router-health-check-failure-threshold", "30",
+    ] + variant_md_args()
+
+
+def variant_md_args() -> list[str]:
+    """Authoring-only: honest calibration variants are copies of this repo with a `variant_md_args.json` (a list of
+    extra MD flags appended last, so they override the defaults above). The reference has no such file."""
+    f = REPO / "variant_md_args.json"
+    return [str(x) for x in json.loads(f.read_text())] if f.exists() else []
+
+
+def ray_env(engine_python: str | None) -> dict:
+    pp = [str(REPO)]
+    if engine_python:
+        pp.insert(0, engine_python)
+    if os.environ.get("PYTHONPATH"):
+        pp.append(os.environ["PYTHONPATH"])
+    return {
+        "PYTHONPATH": os.pathsep.join(pp), "PYTHONUNBUFFERED": "1", "HF_HUB_OFFLINE": "1", "WANDB_MODE": "disabled",
+        # CUDA-IPC weight publication needs legacy cudaIpc handles (pidfd_getfd is not permitted here)
+        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:False", "no_proxy": "127.0.0.1", "MASTER_ADDR": "127.0.0.1",
+    }
+
+
+def build_md(argv: list[str]):
+    sys.argv = ["task_entry"] + argv
+    from miles.utils.arguments import parse_args
+
+    return parse_args()
+
+
+# ------------------------------------------------------------------------------------------------ score
+
+
+def cmd_score(a) -> None:
+    import numpy as np
+    import torch
+
+    from miles.rollout.rm_hub import hpsv3 as H
+
+    z = np.load(a.videos)
+    videos = z["videos"]  # [N, F, H, W, 3] uint8
+    prompts = [json.loads(line)["prompt"] for line in open(a.prompts)]
+    contract = json.load(open(a.contract)) if a.contract else {}
+    base = contract.get("hpsv3_base", "/models/Qwen2-VL-7B-Instruct")
+    ckpt = contract.get("hpsv3_checkpoint", "/models/HPSv3/HPSv3.safetensors")
+    proc = H.load_processor(base)
+    rid = proc.tokenizer.convert_tokens_to_ids(H.REWARD_TOKEN)
+    model = H.build_model(ckpt, base, rid, len(proc.tokenizer), "cuda")
+    frames, fprompts = [], []
+    for v, p in zip(videos, prompts, strict=True):
+        for f in H.FRAME_INDICES:
+            frames.append(H.resize_frame(np.ascontiguousarray(v[f])))
+            fprompts.append(p)
+    mus = []
+    with torch.no_grad():
+        for s in range(0, len(frames), 16):
+            inp = H.processor_inputs(proc, frames[s:s + 16], fprompts[s:s + 16])
+            inp = {k: t.to("cuda") for k, t in inp.items()}
+            logits = model.reward(inp["input_ids"], inp["attention_mask"], inp["pixel_values"], inp["image_grid_thw"],
+                                  inp.get("mm_token_type_ids"))
+            mus.extend(logits[:, 0].float().cpu().tolist())
+    k = len(H.FRAME_INDICES)
+    frame_mu = [mus[i * k:(i + 1) * k] for i in range(len(prompts))]
+    out = Path(a.out)
+    out.mkdir(parents=True, exist_ok=True)
+    (out / "scores.json").write_text(json.dumps(
+        {"frame_mu": frame_mu, "reward": [H.REWARD_SCALE * sum(m) / k for m in frame_mu]}))
+
+
+# ------------------------------------------------------------------------------------------------ run
+
+
+def cmd_run(a) -> None:
+    import ray
+
+    c = json.load(open(a.contract))
+    out = Path(a.out)
+    scratch = Path(c.get("scratch", "/tmp/wan_scratch"))
+    scratch.mkdir(parents=True, exist_ok=True)
+    out.mkdir(parents=True, exist_ok=True)
+    r = c["run"]
+    rows = [json.loads(line) for line in open(r["prompts"])]
+    R, P = int(r["rounds"]), int(r["prompts_per_round"])
+    data = scratch / "run_prompts.jsonl"
+    with open(data, "w") as f:
+        for i in range(R * P):
+            f.write(json.dumps({"input": rows[i]["prompt"], "metadata": {"round": i // P, "row": rows[i]["row"]}}) + "\n")
+    engine_python = merged_engine_python(c, scratch)
+    argv = common_md_args(c) + [
+        "--rollout-function-path", "miles.rollout.sglang_diffusion_rollout.generate_rollout",
+        "--prompt-data", str(data), "--input-key", "input", "--metadata-key", "metadata",
+        "--rollout-batch-size", str(P), "--n-samples-per-prompt", str(r["n"]),
+        "--num-steps-per-rollout", str(r["optimizer_steps_per_round"]), "--num-rollout", str(R),
+        "--rollout-seed", str(r["run_seed"]), "--diffusion-canonical-rng",
+        "--pair-log-dir", str(out / "pairs"),
+    ]
+    start_ray()
+    ray.init(address="auto", runtime_env={"env_vars": ray_env(engine_python)})
+    args = build_md(argv)
+    from miles.ray.placement_group import create_placement_groups, create_rollout_manager, create_training_models
+
+    pgs = create_placement_groups(args)
+    rm, _ = create_rollout_manager(args, pgs["rollout"])
+    actor = create_training_models(args, pgs, rm)
+    if args.offload_rollout:
+        ray.get(rm.onload_weights.remote())
+    actor.update_weights()
+    for rid in range(R):
+        _log(f"round {rid}: rollout")
+        data_ref = ray.get(rm.generate.remote(rid))
+        if args.offload_rollout:
+            ray.get(rm.offload.remote())
+        _log(f"round {rid}: train")
+        ray.get(actor.async_train(rid, data_ref))
+        if rid == R - 1:
+            actor.export_full_state(str(out / "final" / "master_fp32.safetensors"),
+                                    str(out / "final" / "published_bf16.safetensors"))
+        if args.offload_train:
+            actor.offload()
+        else:
+            actor.clear_memory()
+        if args.offload_rollout:
+            ray.get(rm.onload_weights.remote())
+        _log(f"round {rid}: publish")
+        actor.update_weights()
+    ray.get(rm.dispose.remote())
+    _log("run done")
+
+
+# ------------------------------------------------------------------------------------------------ serve
+
+
+def cmd_serve(a) -> None:
+    import ray
+
+    c = json.load(open(a.contract))
+    out = Path(a.out)
+    out.mkdir(parents=True, exist_ok=True)
+    rp = c["replay"]
+    events = open(a.events, "w", buffering=1)
+
+    def emit(obj):
+        events.write(json.dumps(obj) + "\n")
+        events.flush()
+
+    # The Judge launches its engines before this process starts and lists their URLs in the contract.
+    scratch = Path(c.get("scratch", "/tmp/wan_scratch"))
+    scratch.mkdir(parents=True, exist_ok=True)
+    placeholder = scratch / "replay_placeholder.jsonl"  # the data source is unused by the replay rollout
+    placeholder.write_text(json.dumps({"input": "replay"}) + "\n")
+    argv = common_md_args(c) + [
+        "--rollout-function-path", "miles.rollout.replay_rollout.generate_replay",
+        "--prompt-data", str(placeholder), "--input-key", "input",
+        "--rollout-batch-size", str(rp["prompts_per_dump"]), "--n-samples-per-prompt", str(rp["n"]),
+        "--num-steps-per-rollout", str(rp["optimizer_steps"]), "--num-rollout", "1000000",
+        "--rollout-external-engine-urls", ",".join(c["replay"]["engine_urls"]),
+        "--no-offload-train", "--no-offload-rollout",
+        "--pair-log-dir", str(out / "pairs"),
+    ]
+    start_ray()
+    ray.init(address="auto", runtime_env={"env_vars": ray_env(None)})
+    args = build_md(argv)
+    from miles.ray.placement_group import create_placement_groups, create_rollout_manager, create_training_models
+
+    pgs = create_placement_groups(args)
+    rm, _ = create_rollout_manager(args, pgs["rollout"])
+    actor = create_training_models(args, pgs, rm)
+    actor.snapshot_base()
+    emit({"event": "ready"})
+    rid = 0
+    with open(a.ctl) as ctl:
+        for line in ctl:
+            if not line.strip():
+                continue
+            msg = json.loads(line)
+            cmd = msg["cmd"]
+            if cmd == "stop":
+                emit({"event": "stopped"})
+                break
+            if cmd in ("probe", "replay"):
+                steps = int(rp["probe_optimizer_steps"] if cmd == "probe" else rp["optimizer_steps"])
+                prompts = int(msg.get("prompts", rp["prompts_per_dump"]))
+                fields = {"replay_dump_path": msg["dump"], "num_steps_per_rollout": steps,
+                          "rollout_batch_size": prompts,
+                          "global_batch_size": prompts * int(rp["n"]) // steps,
+                          "pair_log_dir": str(out / "pairs" / f"{cmd}{rid:02d}")}
+                ray.get(rm.update_args.remote(fields))
+                actor.update_args(fields)
+                data_ref = ray.get(rm.generate.remote(rid))
+                ray.get(actor.async_train(rid, data_ref))
+                del data_ref  # free the train shards from the object store before the next go
+                emit({"event": "log_complete", "id": msg.get("id"), "pair_log": fields["pair_log_dir"]})
+                if cmd == "probe":
+                    actor.export_full_state(msg["theta1_path"], None)
+                else:
+                    actor.update_weights()
+                emit({"event": "done", "id": msg.get("id")})
+                rid += 1
+            elif cmd == "dump_master":
+                actor.export_full_state(msg["path"], msg.get("bf16_path"))
+                emit({"event": "done", "id": msg.get("id")})
+            elif cmd == "reset":
+                actor.reset_to_base()
+                emit({"event": "done", "id": msg.get("id")})
+            else:
+                emit({"event": "error", "message": f"unknown cmd {cmd}"})
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    s = sub.add_parser("score")
+    s.add_argument("--videos", required=True)
+    s.add_argument("--prompts", required=True)
+    s.add_argument("--contract", default=None)
+    s.add_argument("--out", required=True)
+    r = sub.add_parser("run")
+    r.add_argument("--contract", required=True)
+    r.add_argument("--out", required=True)
+    v = sub.add_parser("serve")
+    v.add_argument("--contract", required=True)
+    v.add_argument("--ctl", required=True)
+    v.add_argument("--events", required=True)
+    v.add_argument("--out", required=True)
+    a = ap.parse_args()
+    sys.path.insert(0, str(REPO))
+    {"score": cmd_score, "run": cmd_run, "serve": cmd_serve}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    main()
