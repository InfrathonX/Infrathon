+"""Wan2.2-TI2V-5B training pipeline config (single expert, T2V mode).
+
+TI2V-5B ships one ``transformer`` (model_index ``transformer_2: [null, null]``, ``boundary_ratio: null``), so there
+is no high/low-noise expert switch and no ``guidance_scale_2``. Otherwise it shares the Wan2.2 DiT interface
+(T5 ``encoder_hidden_states``, sequential CFG, GEMM patchify parity hook).
+"""
+
+from __future__ import annotations
+
+from .train_pipeline_config import register_train_pipeline_config
+from .wan2_2 import Wan2_2TrainPipelineConfig
+
+
+@register_train_pipeline_config("wan2_2_ti2v")
+class Wan2_2TI2VTrainPipelineConfig(Wan2_2TrainPipelineConfig):
+    hf_ckpt_name_patterns = ("wan2.2-ti2v", "wan-2.2-ti2v")
+    boundary_ratio = None
+
+    def component_for_timestep(self, timestep: float, num_train_timesteps: int) -> str:
+        return "transformer"
+
+    def select_guidance_scale(
+        self,
+        timestep: float,
+        num_train_timesteps: int,
+        guidance_scale: float,
+        guidance_scale_2: float | None,
+    ) -> float:
+        if guidance_scale_2 is not None:
+            raise ValueError("Wan2.2-TI2V-5B has a single expert; --diffusion-guidance-scale-2 does not apply")
+        return guidance_scale
