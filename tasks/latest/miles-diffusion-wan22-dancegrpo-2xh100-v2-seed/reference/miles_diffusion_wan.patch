+class DanceSdeStepBackend(DiffusersSdeStepBackend):
+    """DanceGRPO dynamics (sgl-d ``rollout_sde_type="dance"``; XueZeyue/DanceGRPO ``flux_step``, verl-omni ``dance_sde``).
