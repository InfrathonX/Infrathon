+    x0 = x - sigma*v;  mean = x + dt*v + 0.5*eta^2*(x - x0*(1-sigma))/sigma^2*dt;  std = eta*sqrt(sigma - sigma_next).
+    Unlike flow-SDE there is no sigma/(1-sigma) factor, so the sigma == 1 step needs no guard. The log-prob drops the
+    Gaussian constants (they cancel in the PPO ratio): mean over elements of -(x' - mean)^2 / (2 std^2).
+    """
+
+    def prev_sample_mean_and_std(
+        self,
+        model_output: torch.Tensor,
+        sample: torch.Tensor,
+        sigma: torch.Tensor,
+        sigma_prev: torch.Tensor,
+        *,
+        noise_level: float,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        dt = sigma_prev - sigma
+        pred_original = sample - sigma * model_output
+        score_term = 0.5 * noise_level**2 * (sample - pred_original * (1 - sigma)) / sigma**2
+        prev_mean = sample + dt * model_output + score_term * dt
+        noise_std = noise_level * torch.sqrt(-1 * dt)
+        return prev_mean, noise_std, noise_std
+
+    def log_prob(
+        self,
+        prev_sample: torch.Tensor,
+        prev_mean: torch.Tensor,
+        noise_std: torch.Tensor,
+    ) -> torch.Tensor:
+        log_prob = -((prev_sample.detach() - prev_mean) ** 2) / (2 * noise_std**2)
+        return log_prob.mean(dim=tuple(range(1, log_prob.ndim)))
