new file mode 100644
index 0000000..4e4865b
--- /dev/null
+++ b/miles/utils/pair_log.py
@@ -0,0 +1,42 @@
+"""Per-pair training log (audit trail): one JSON line per (pair, event) written by each train rank.
+
+Events: ``pi_old`` (the recomputed old log-prob of a pair) and ``step`` (one optimizer-step contribution: clipped
+advantage, pi_old, pi_new, ratio, clip mask, per-pair loss). Pairs are identified by the canonical seed-group key
+(``group``, ``j``) and the absolute denoising step ``k``. Enabled by ``--pair-log-dir``.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+
+_buffer: list[dict] = []
+
+
+def enabled(args) -> bool:
+    return bool(getattr(args, "pair_log_dir", None))
+
+
+def pair_id(pair: dict) -> dict:
+    can = pair.get("canonical") or {}
+    return {"group": can.get("group"), "j": can.get("j"), "k": pair.get("sde_step"), "sample_index": pair.get("sample_index")}
+
+
+def record(event: dict) -> None:
+    _buffer.append(event)
+
+
+def flush(args, rollout_id: int, rank: int) -> str | None:
+    """Write and fsync this rank's buffered events for ``rollout_id``; returns the file path."""
+    if not enabled(args):
+        _buffer.clear()
+        return None
+    os.makedirs(args.pair_log_dir, exist_ok=True)
+    path = os.path.join(args.pair_log_dir, f"rollout{rollout_id:03d}_rank{rank}.jsonl")
+    with open(path, "w") as f:
+        for ev in _buffer:
+            f.write(json.dumps(ev, separators=(",", ":")) + "\n")
+        f.flush()
+        os.fsync(f.fileno())
+    _buffer.clear()
+    return path
