diff --git a/miles/rollout/canonical_rng.py b/miles/rollout/canonical_rng.py
new file mode 100644
index 0000000..a35b4fd
--- /dev/null
+++ b/miles/rollout/canonical_rng.py
@@ -0,0 +1,39 @@
+"""Canonical RNG keys for seed-group rollouts (DanceGRPO ``init_same_noise``; verl-omni per-sample windows).
+
+Group g = (run_seed, round, prompt_row); sample j in [0, n):
+  - initial noise x_T: CPU generator seeded with H("init|g"), shared by the whole group;
+  - SDE window start: H("win|g|j") mod window_starts, window = {w, w+1, ...};
+  - SDE noise: CPU generator seeded with H("sde|g|j"), one draw per window step in step order.
+H(s) = first 8 bytes of sha256(s), big-endian, mod 2**63.
+"""
+
+from __future__ import annotations
+
+import hashlib
+
+_MOD = 1 << 63
+
+
+def canonical_key(s: str) -> int:
+    return int.from_bytes(hashlib.sha256(s.encode("utf-8")).digest()[:8], "big") % _MOD
+
+
+def group_base(run_seed: int, round_id: int, prompt_row: int) -> str:
+    return f"{run_seed}|{round_id}|{prompt_row}"
+
+
+def init_seed(base: str) -> int:
+    return canonical_key(f"init|{base}")
+
+
+def sde_noise_seed(base: str, j: int) -> int:
+    return canonical_key(f"sde|{base}|{j}")
+
+
+def window(base: str, j: int, window_size: int, lo: int, hi: int) -> list[int]:
+    """Window of `window_size` consecutive steps, start in [lo, hi - window_size] (sde_window semantics)."""
+    n_starts = hi - window_size + 1 - lo
+    if n_starts <= 0:
+        raise ValueError(f"empty window range lo={lo} hi={hi} size={window_size}")
+    start = lo + canonical_key(f"win|{base}|{j}") % n_starts
+    return list(range(start, start + window_size))
diff --git a/miles/rollout/replay_rollout.py b/miles/rollout/replay_rollout.py
new file mode 100644
index 0000000..9981f21
--- /dev/null
+++ b/miles/rollout/replay_rollout.py
@@ -0,0 +1,98 @@
+"""Fixed-replay rollout: training samples come from a frozen dump instead of the engine.
+
+Dump layout (a directory, written by the replay owner; ``args.replay_dump_path`` points at it):
+
+- ``meta.json``: ``{"run_seed", "round", "rows": [P], "prompts": [P], "n", "windows": [[P][n] start],
+  "timesteps": [T+1], "sigmas": [T+1]}``;
+- ``frames.npy``: uint8 ``[P, n, F, H, W, 3]`` decoded videos (the engine's uint8 output);
+- ``latents.safetensors``: ``x`` ``[P, n, 3, C, F', H', W']`` = x_w, x_{w+1}, x_{w+2} as the engine stored them;
+- ``cond.safetensors``: ``pos`` / ``neg`` ``[P, L, D]`` text conditioning captured from the engine.
+
+There are no engine log-probs: old log-probs are recomputed by the trainer (``--diffusion-recompute-old-log-prob``).
+Rewards are computed here with the configured reward model; the rest of the pipeline (advantages, train pairs,
+optimizer steps, publication) is the normal one.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from argparse import Namespace
+from typing import Any
+
+import numpy as np
+import torch
+from safetensors.torch import load_file
+
+from miles.rollout import canonical_rng as crng
+from miles.rollout.base_types import RolloutFnTrainOutput
+from miles.rollout.rm_hub import batched_async_rm
+from miles.utils.async_utils import run
+from miles.utils.types import CondKwargs, DenoisingEnv, DiTTrajectory, Sample
+
+
+def load_replay_samples(dump_dir: str, window_size: int) -> list[list[Sample]]:
+    meta = json.load(open(os.path.join(dump_dir, "meta.json")))
+    frames = np.load(os.path.join(dump_dir, "frames.npy"), mmap_mode="r")
+    lat = load_file(os.path.join(dump_dir, "latents.safetensors"))["x"]
+    cond = load_file(os.path.join(dump_dir, "cond.safetensors"))
+    timesteps = torch.tensor(meta["timesteps"], dtype=torch.float32)
+    sigmas = torch.tensor(meta["sigmas"], dtype=torch.float32)
+    n_steps = len(meta["timesteps"]) - 1
+    groups = []
+    idx = 0
+    for g, (row, prompt) in enumerate(zip(meta["rows"], meta["prompts"], strict=True)):
+        base = crng.group_base(int(meta["run_seed"]), int(meta["round"]), int(row))
+        pos, neg = cond["pos"][g].clone(), cond["neg"][g].clone()
+        group = []
+        for j in range(int(meta["n"])):
+            w = int(meta["windows"][g][j])
+            win = list(range(w, w + window_size))
+            s = Sample(prompt=prompt, index=idx, group_index=g)
+            idx += 1
+            s.generated_output = torch.from_numpy(np.ascontiguousarray(frames[g, j])).permute(3, 0, 1, 2).contiguous()
+            # .clone(): a view would drag the whole dump tensor's storage into every pickled pair (Ray spills GBs)
+            s.dit_trajectory = DiTTrajectory(
+                latents=lat[g, j].clone(),
+                timesteps=timesteps,
+                sigmas=sigmas,
+                latent_step_indices=torch.tensor(win + [win[-1] + 1], dtype=torch.long),
+            )
+            s.rollout_log_probs = torch.zeros(n_steps, dtype=torch.float32)  # unused: old log-probs are recomputed
+            s.denoising_env = DenoisingEnv(
+                pos_cond_kwargs=CondKwargs(encoder_hidden_states=[pos]),
+                neg_cond_kwargs=CondKwargs(encoder_hidden_states=[neg]),
+            )
+            s.train_metadata = {"sde_step_indices": win}
+            s.metadata = {"round": int(meta["round"]), "row": int(row),
+                          "canonical_rng": {"group": base, "j": j, "window": win}}
+            group.append(s)
+        groups.append(group)
+    return groups
+
+
+def contract_group_order(num_prompts: int, num_steps: int, dp_size: int) -> list[int]:
+    """Replay contract: optimizer step k trains the pairs of prompts [k*P/S, (k+1)*P/S). Miles splits the flat sample
+    list contiguously across DP ranks and each rank walks its shard in ``num_steps`` chunks, so emit the groups in the
+    order that makes (rank d, local step k) receive prompts k*P/S + d*P/(S*D) + [0, P/(S*D))."""
+    if num_steps == 1:
+        return list(range(num_prompts))  # a single optimizer step: composition is fixed regardless of the split
+    per_step = num_prompts // num_steps
+    per_rank_step = per_step // dp_size
+    if per_step * num_steps != num_prompts or per_rank_step * dp_size != per_step:
+        raise ValueError(f"{num_prompts} prompts do not split into {num_steps} steps x {dp_size} ranks")
+    return [k * per_step + d * per_rank_step + i
+            for d in range(dp_size) for k in range(num_steps) for i in range(per_rank_step)]
+
+
+def generate_replay(args: Namespace, rollout_id: int, data_source: Any, evaluation: bool = False):
+    if evaluation:
+        raise NotImplementedError("fixed replay has no evaluation rollout")
+    groups = load_replay_samples(args.replay_dump_path, int(args.diffusion_num_sde_steps))
+    dp_size = int(args.actor_num_nodes) * int(args.actor_num_gpus_per_node)
+    groups = [groups[i] for i in contract_group_order(len(groups), int(args.num_steps_per_rollout), dp_size)]
+    flat = [s for g in groups for s in g]
+    rewards = run(batched_async_rm(args, flat))
+    for s, r in zip(flat, rewards, strict=True):
+        s.reward = r
+    return RolloutFnTrainOutput(samples=groups, metrics={})
