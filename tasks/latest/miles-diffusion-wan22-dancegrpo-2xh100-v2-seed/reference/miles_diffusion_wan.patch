+async def _generate_and_rm_group_canonical(
+    args: Namespace, group: list[Sample], sampling_params: dict[str, Any]
+) -> list[Sample]:
+    """One request per sample with canonical seed-group keys (see miles.rollout.canonical_rng)."""
+    from miles.rollout import canonical_rng as crng
+
+    md = group[0].metadata if isinstance(group[0].metadata, dict) else {}
+    if "round" not in md or "row" not in md:
+        raise ValueError("--diffusion-canonical-rng needs sample.metadata['round'] and ['row']")
+    base = crng.group_base(int(args.rollout_seed), int(md["round"]), int(md["row"]))
+    lo, hi = _parse_window_range(args, int(sampling_params["num_inference_steps"]))
+    tasks = []
+    for j, sample in enumerate(group):
+        params = sampling_params.copy()
+        params["seed"] = crng.init_seed(base)
+        params["generator_device"] = "cpu"
+        extra = dict(params.get("extra_sampling_params") or {})
+        extra["rollout_sde_noise_seed"] = crng.sde_noise_seed(base, j)
+        params["extra_sampling_params"] = extra
+        win = crng.window(base, j, int(args.diffusion_num_sde_steps), lo, hi)
+        params["rollout_sde_step_indices"] = win
+        params["rollout_return_step_indices"] = win + [win[-1] + 1]
+        smd = dict(sample.metadata) if isinstance(sample.metadata, dict) else {}
+        smd["canonical_rng"] = {"group": base, "j": j, "window": win}
+        sample.metadata = smd
+        tasks.append(asyncio.create_task(generate_and_rm_microgroup(args, [sample], params)))
+    microgroups = await asyncio.gather(*tasks)
+    group = [s for mg in microgroups for s in mg]
+    if args.group_rm:
+        rewards = await batched_async_rm(args, group)
+        for sample, reward in zip(group, rewards, strict=True):
+            sample.reward = reward
+    return group
+
+
+def _parse_window_range(args: Namespace, num_steps: int) -> tuple[int, int]:
+    if args.diffusion_sde_window_range:
+        lo, hi = (int(x) for x in args.diffusion_sde_window_range.split(","))
+    else:
+        lo, hi = 0, num_steps
+    return lo, hi
