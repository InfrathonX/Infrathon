diff --git a/miles/backends/fsdp_utils/loss_hub/opd.py b/miles/backends/fsdp_utils/loss_hub/opd.py
new file mode 100644
index 00000000..b9bc7862
--- /dev/null
+++ b/miles/backends/fsdp_utils/loss_hub/opd.py
@@ -0,0 +1,109 @@
+"""On-policy distillation (DiffusionOPD) batch preparation and loss formula.
+
+For every train pair (x_i, t_i, t_{i+1}, cond) on the student's own CPS trajectory, the student and the
+routed frozen teacher each predict a velocity at the same x_i with the same conditioning; both are
+pushed through the same CPS transition kernel and the loss is the closed-form Gaussian KL between the
+two transition distributions (shared std s_t = sigma_{i+1} sin(eta pi / 2)):
+
+    KL_i / D = mean_over_elements((mu(v_S) - mu(v_T))^2) / (2 s_t^2)
+
+The actor normalises ``loss_sum`` by the local pair count; with equal pairs per DP rank the gradient is
+that of the global pair mean. Gradients flow only through the student prediction.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+
+from miles.backends.fsdp_utils.loss_hub.types import DiffusionLossContext, PreparedBatch
+from miles.utils.metric_buffer import MetricBuffer
+
+
+def prepare_opd_batch(ctx: DiffusionLossContext, batch: list[dict], *, pad_to_len: int | None = None) -> PreparedBatch:
+    args, device, config = ctx.args, ctx.device, ctx.train_pipeline_config
+    if len(ctx.models) != 1:
+        raise ValueError("OPD supports single-DiT families")
+    if args.diffusion_true_cfg_scale is not None or args.diffusion_guidance_scale > 1.0:
+        raise ValueError("OPD student and teachers run the conditional branch only (guidance 1.0)")
+    component_name, model = next(iter(ctx.models.items()))
+
+    latents = torch.stack([pair["latent"] for pair in batch]).to(device=device, dtype=torch.float32)
+    timesteps = torch.stack([pair["timestep"] for pair in batch]).to(device=device, dtype=torch.float32)
+    next_timesteps = torch.stack([pair["next_timestep"] for pair in batch]).to(device=device, dtype=torch.float32)
+    pos_list = [config.prepare_cond_kwargs(pair["denoising_env"].pos_cond_kwargs, device) for pair in batch]
+    pos_cond = config.collate_cond_for_sample_batch(pos_list, device, pad_to_len=pad_to_len)
+
+    model_t = next_timesteps if os.environ.get("OPD_AUTHOR_VARIANT") == "t_next_input" else timesteps  # planted bug
+    return PreparedBatch(
+        latents=latents,
+        timesteps=timesteps,
+        timesteps_for_model=config.process_timestep_as_input(model_t),
+        model=model,
+        component_name=component_name,
+        guidance_scale=1.0,
+        use_cfg=False,
+        cfg_batching=False,
+        true_cfg_scale=None,
+        pos_cond=pos_cond,
+        neg_cond=None,
+        joint_cond=None,
+        advantage=torch.zeros(len(batch), device=device),
+        extras={"next_timesteps": next_timesteps, "routes": [pair["teacher_route"] for pair in batch]},
+    )
+
+
+def cps_transition_means(ctx: DiffusionLossContext, prepared: PreparedBatch, pred: torch.Tensor):
+    """(mu, std) of the CPS transition from x_i under a velocity prediction, in fp32."""
+    sigma, sigma_next = ctx.sde_backend.resolve_sigmas(
+        prepared.timesteps, prepared.extras["next_timesteps"], ndim=prepared.latents.ndim
+    )
+    mu, std, _ = ctx.sde_backend.prev_sample_mean_and_std(
+        pred.float(), prepared.latents.float(), sigma, sigma_next, noise_level=ctx.args.diffusion_noise_level
+    )
+    return mu, std
+
+
+def opd_loss_formula(
+    ctx: DiffusionLossContext,
+    batch: list[dict],
+    prepared: PreparedBatch,
+    *,
+    new_pred: torch.Tensor,
+    ref_pred: torch.Tensor | None,
+    metrics: MetricBuffer,
+    write_old_log_prob: bool = False,
+    old_log_prob_from_new: bool = False,
+) -> torch.Tensor | None:
+    if write_old_log_prob:
+        return None  # OPD has no importance ratio
+    if ref_pred is None:
+        raise ValueError("OPD needs the routed teacher prediction (actor teacher runtime)")
+    mu_s, std = cps_transition_means(ctx, prepared, new_pred)
+    with torch.no_grad():
+        mu_t, _ = cps_transition_means(ctx, prepared, ref_pred.detach())
+    reduce_dims = tuple(range(1, mu_s.ndim))
+    kl = ((mu_s - mu_t) ** 2).mean(dim=reduce_dims) / (2 * std.flatten() ** 2)
+    loss_sum = kl.sum()
+    variant = os.environ.get("OPD_AUTHOR_VARIANT")  # author-only planted bugs for gate calibration (never shipped)
+    if variant == "uniform_mse":
+        loss_sum = ((mu_s - mu_t) ** 2).mean(dim=reduce_dims).sum() * float((1 / (2 * std.flatten() ** 2)).mean())
+    elif variant == "partial_backward":
+        keep = torch.arange(len(batch), device=kl.device) % 3 == 0
+        loss_sum = kl[keep].sum() + kl[~keep].detach().sum()
+    elif variant == "half_samples":
+        keep = torch.tensor([int(p["output_idx"]) < 4 for p in batch], device=kl.device)
+        loss_sum = kl[keep].sum() + kl[~keep].detach().sum()
+
+    with torch.no_grad():
+        bsz = len(batch)
+        metrics.emit_mean("loss", total=loss_sum.detach(), count=bsz)
+        metrics.emit_mean("opd_kl", total=loss_sum.detach(), count=bsz)
+        keep_means = bool(getattr(ctx, "keep_means", False))
+        for j, (pair, kl_j) in enumerate(zip(batch, kl.detach().tolist(), strict=True)):
+            pair["opd_kl"] = kl_j
+            if keep_means:
+                pair["opd_mu_student"] = mu_s[j].detach().float().cpu()
+                pair["opd_mu_teacher"] = mu_t[j].float().cpu()
+    return loss_sum
diff --git a/miles/backends/fsdp_utils/opd_dump.py b/miles/backends/fsdp_utils/opd_dump.py
new file mode 100644
index 00000000..28fb389e
--- /dev/null
+++ b/miles/backends/fsdp_utils/opd_dump.py
@@ -0,0 +1,91 @@
+"""Per-optimizer-step records for ``--loss-type opd`` (``--opd-dump-dir``) and ``--student-init`` loading.
+
+Record ``step_{k:05d}.pt`` (written by global rank 0) holds everything an external checker needs to
+replay step k of AdamW and to recompute its gradient:
+  pairs          [(row_id, output_idx, request_id, step_index, route, kl)] over all DP ranks
+  lora_pre       {peft_key: fp32} student LoRA before the update (PEFT file naming, no adapter name)
+  exp_avg/exp_avg_sq {peft_key: fp32} AdamW moments after the update, ``adam_step`` its step count
+  grad_norm_preclip, lr, loss (global pair mean the backward used)
+The first ``--opd-dump-means-steps`` steps also carry per-pair fp32 student/teacher transition means and lora_post;
+the run's last step always carries lora_post (the final student).
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import torch.distributed as dist
+from safetensors.torch import load_file
+
+ADAPTER = ".default"
+
+
+def peft_key(param_name: str) -> str:
+    return param_name.replace(f"{ADAPTER}.weight", ".weight")
+
+
+def _full(t: torch.Tensor) -> torch.Tensor:
+    return (t.full_tensor() if hasattr(t, "full_tensor") else t).detach().float().cpu()
+
+
+def trainable_lora(model: torch.nn.Module):
+    return [(n, p) for n, p in model.named_parameters() if p.requires_grad]
+
+
+def load_student_init_(model: torch.nn.Module, path: str) -> int:
+    """Copy PEFT-named LoRA tensors into the (unsharded, rank-0) student adapter; exact key coverage."""
+    tensors = load_file(path)
+    params = dict(trainable_lora(model))
+    by_key = {peft_key(n): p for n, p in params.items()}
+    if set(by_key) != set(tensors):
+        missing, extra = sorted(set(by_key) - set(tensors)), sorted(set(tensors) - set(by_key))
+        raise ValueError(f"--student-init keys differ from the student adapter: missing={missing[:4]} extra={extra[:4]}")
+    with torch.no_grad():
+        for key, p in by_key.items():
+            if tuple(tensors[key].shape) != tuple(p.shape):
+                raise ValueError(f"--student-init {key} shape {tuple(tensors[key].shape)} != {tuple(p.shape)}")
+            p.copy_(tensors[key].to(p.dtype))
+    return len(by_key)
+
+
+def snapshot_lora(model: torch.nn.Module) -> dict[str, torch.Tensor]:
+    """Full fp32 copy of the student LoRA (collective over FSDP ranks)."""
+    return {peft_key(n): _full(p) for n, p in trainable_lora(model)}
+
+
+def snapshot_adam(model: torch.nn.Module, optimizer) -> tuple[dict, dict, int]:
+    m, v, step = {}, {}, None
+    for n, p in trainable_lora(model):
+        state = optimizer.state[p]
+        m[peft_key(n)] = _full(state["exp_avg"])
+        v[peft_key(n)] = _full(state["exp_avg_sq"])
+        s = int(state["step"].item() if torch.is_tensor(state["step"]) else state["step"])
+        if step is not None and s != step:
+            raise RuntimeError("AdamW step counts differ across parameters")
+        step = s
+    return m, v, step
+
+
+def write_step(dump_dir: str, step: int, record: dict, local_pairs: list[dict], group) -> None:
+    """Gather every rank's pair records and write one file from global rank 0."""
+    rows = [
+        (p.get("row_id"), p.get("output_idx"), p.get("request_id"), p.get("step_index"), p.get("teacher_route"),
+         p.get("opd_kl"))
+        for p in local_pairs
+    ]
+    means = None
+    if any("opd_mu_student" in p for p in local_pairs):
+        means = [(p["opd_mu_student"], p["opd_mu_teacher"]) for p in local_pairs]
+    gathered = [None] * dist.get_world_size(group)
+    dist.all_gather_object(gathered, {"pairs": rows, "means": means}, group=group)
+    if dist.get_rank() != 0:
+        return
+    record = dict(record)
+    record["pairs"] = [row for g in gathered for row in g["pairs"]]
+    if means is not None:
+        record["means"] = [m for g in gathered for m in (g["means"] or [])]
+    os.makedirs(dump_dir, exist_ok=True)
+    tmp = os.path.join(dump_dir, f".step_{step:05d}.pt.tmp")
+    torch.save(record, tmp)
+    os.replace(tmp, os.path.join(dump_dir, f"step_{step:05d}.pt"))
diff --git a/miles/backends/fsdp_utils/teacher.py b/miles/backends/fsdp_utils/teacher.py
new file mode 100644
index 00000000..2d327575
--- /dev/null
+++ b/miles/backends/fsdp_utils/teacher.py
@@ -0,0 +1,139 @@
+"""Frozen, routed teacher runtime for on-policy distillation (``--loss-type opd``).
+
+Each ``--teacher-model KEY=PATH`` becomes one full, frozen DiT copy on this rank's GPU:
+- PATH is a PEFT LoRA adapter dir (adapter_config.json + adapter_model.safetensors): the base
+  ``--hf-checkpoint`` component is loaded in fp32, ``W += (alpha / r) * B @ A`` is merged in fp32, and the
+  merged model is stored in the forward dtype (no adapter layers remain, so a teacher can never share or
+  leak into the student's PEFT adapter or its weight publication);
+- PATH is a diffusers component dir: loaded as is.
+
+Teachers never pass through FSDP or the optimizer and are not offloaded with the student.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+
+import torch
+from safetensors.torch import load_file
+
+logger = logging.getLogger(__name__)
+
+PEFT_PREFIX = "base_model.model."
+
+
+def _merge_peft_lora_(model: torch.nn.Module, adapter_dir: str) -> int:
+    cfg = json.load(open(os.path.join(adapter_dir, "adapter_config.json")))
+    if cfg.get("use_dora") or cfg.get("use_rslora") or cfg.get("rank_pattern") or cfg.get("alpha_pattern"):
+        raise ValueError(f"unsupported LoRA variant in {adapter_dir}")
+    scale = float(cfg["lora_alpha"]) / float(cfg["r"])
+    tensors = load_file(os.path.join(adapter_dir, "adapter_model.safetensors"))
+    modules = dict(model.named_modules())
+    pairs: dict[str, dict[str, torch.Tensor]] = {}
+    for key, value in tensors.items():
+        name = key[len(PEFT_PREFIX):] if key.startswith(PEFT_PREFIX) else key
+        for tag in ("lora_A", "lora_B"):
+            suffix = f".{tag}.weight"
+            if name.endswith(suffix):
+                pairs.setdefault(name[: -len(suffix)], {})[tag] = value
+                break
+        else:
+            raise ValueError(f"unexpected key {key} in {adapter_dir}")
+    with torch.no_grad():
+        for name, ab in pairs.items():
+            linear = modules[name]
+            delta = scale * (ab["lora_B"].float() @ ab["lora_A"].float())
+            linear.weight.copy_((linear.weight.float() + delta).to(linear.weight.dtype))
+    return len(pairs)
+
+
+def _load_peft_lora_factors(adapter_dir: str, dtype: torch.dtype, device) -> tuple[float, dict[str, tuple[torch.Tensor, torch.Tensor]]]:
+    cfg = json.load(open(os.path.join(adapter_dir, "adapter_config.json")))
+    scale = float(cfg["lora_alpha"]) / float(cfg["r"])
+    tensors = load_file(os.path.join(adapter_dir, "adapter_model.safetensors"))
+    factors: dict[str, dict[str, torch.Tensor]] = {}
+    for key, value in tensors.items():
+        name = key[len(PEFT_PREFIX):] if key.startswith(PEFT_PREFIX) else key
+        tag = "lora_A" if name.endswith(".lora_A.weight") else "lora_B"
+        factors.setdefault(name.rsplit(f".{tag}.weight", 1)[0], {})[tag] = value.to(device=device, dtype=dtype)
+    return scale, {name: (ab["lora_A"], ab["lora_B"]) for name, ab in factors.items()}
+
+
+class TeacherRuntime:
+    def __init__(self, args, model_backend, train_pipeline_config, forward_dtype: torch.dtype, device: torch.device):
+        self.args = args
+        self.config = train_pipeline_config
+        self.forward_dtype = forward_dtype
+        self.device = device
+        self.teachers: dict[str, torch.nn.Module] = {}
+        self.unmerged: dict[str, tuple[float, dict]] = {}
+        component = args.update_weight_target_modules[0]
+        if os.environ.get("OPD_AUTHOR_VARIANT") == "teacher_unmerged":
+            # author-only HONEST variant for gate calibration: one frozen base copy in the forward dtype, each
+            # teacher's LoRA applied unmerged (x @ A^T @ B^T * alpha/r added to the base output) per route
+            base = model_backend.load_component(component, args, master_dtype=torch.float32, materialize_weights=True)
+            if args.fsdp_attention_backend is not None:
+                model_backend.set_attention_backend(base, args.fsdp_attention_backend)
+            self.base = base.to(device=device, dtype=forward_dtype).eval().requires_grad_(False)
+            for spec in args.teacher_model:
+                key, path = spec.split("=", 1)
+                self.unmerged[key] = _load_peft_lora_factors(path, forward_dtype, device)
+                self.teachers[key] = self.base
+            return
+        for spec in args.teacher_model:
+            key, path = spec.split("=", 1)
+            if os.path.isfile(os.path.join(path, "adapter_config.json")):
+                model = model_backend.load_component(component, args, master_dtype=torch.float32, materialize_weights=True)
+                # author-only planted bug for gate calibration (never shipped): the base DiT scores as teacher
+                merged = 0 if os.environ.get("OPD_AUTHOR_VARIANT") == "teacher_is_base" else _merge_peft_lora_(model, path)
+                logger.info("teacher %s: merged %d LoRA modules from %s", key, merged, path)
+            else:
+                model_cls = model_backend._resolve_component_class(args, component)
+                model = model_cls.from_pretrained(path, torch_dtype=torch.float32)
+                logger.info("teacher %s: loaded full DiT from %s", key, path)
+            if args.fsdp_attention_backend is not None:
+                model_backend.set_attention_backend(model, args.fsdp_attention_backend)
+            model = model.to(device=device, dtype=forward_dtype).eval().requires_grad_(False)
+            self.teachers[key] = model
+
+    @torch.no_grad()
+    def predict(self, routes: list[str], latents: torch.Tensor, timesteps: torch.Tensor, pos_cond: dict) -> torch.Tensor:
+        """Velocity of each pair's routed teacher at the pair's own state (conditional branch only)."""
+        out = None
+        if os.environ.get("OPD_AUTHOR_VARIANT") == "route_swap":  # author-only planted bug: routes exchanged
+            keys = sorted(self.teachers)
+            routes = [keys[1 - keys.index(r)] if r in keys and len(keys) == 2 else r for r in routes]
+        for key in sorted(set(routes)):
+            if key not in self.teachers:
+                raise KeyError(f"no --teacher-model for route {key!r} (have {sorted(self.teachers)})")
+            idx = torch.tensor([i for i, r in enumerate(routes) if r == key], device=latents.device)
+            cond = {k: (v.index_select(0, idx) if isinstance(v, torch.Tensor) else v) for k, v in pos_cond.items()}
+            hooks = []
+            if key in self.unmerged:
+                scale, factors = self.unmerged[key]
+                modules = dict(self.base.named_modules())
+                for name, (lora_a, lora_b) in factors.items():
+                    hooks.append(modules[name].register_forward_hook(
+                        lambda mod, inp, outp, a=lora_a, b=lora_b: outp + scale * torch.nn.functional.linear(
+                            torch.nn.functional.linear(inp[0].to(a.dtype), a), b).to(outp.dtype)))
+            with torch.autocast("cuda", dtype=self.forward_dtype, enabled=self.forward_dtype != torch.float32):
+                pred = self.config.compute_noise_pred(
+                    model=self.teachers[key],
+                    latents_input=latents.index_select(0, idx),
+                    timesteps_input=timesteps.index_select(0, idx),
+                    pos_cond=cond,
+                    neg_cond=None,
+                    joint_cond=None,
+                    use_cfg=False,
+                    cfg_batching=False,
+                    guidance_scale=1.0,
+                    true_cfg_scale=None,
+                )
+            for h in hooks:
+                h.remove()
+            if out is None:
+                out = torch.empty((latents.shape[0], *pred.shape[1:]), device=pred.device, dtype=pred.dtype)
+            out.index_copy_(0, idx, pred)
+        return out
