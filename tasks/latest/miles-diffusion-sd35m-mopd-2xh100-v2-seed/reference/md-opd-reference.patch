index 00000000..58b72059
--- /dev/null
+++ b/miles/ray/data_conversion_hub/opd.py
@@ -0,0 +1,99 @@
+"""Convert on-policy distillation (DiffusionOPD) rollout samples into flat train-pair payloads.
+
+One pair per (sample, SDE window step i): the student's own state x_i with the engine's (t_i, t_{i+1})
+and conditioning. The teacher is chosen per sample from ``Sample.metadata[--teacher-key]``. There is no
+reward and no importance ratio, so reward post-processing is skipped entirely.
+
+Pair order: optimizer step ``s`` of a rollout trains the contiguous row block
+``[s*R/S, (s+1)*R/S)`` of that rollout's R prompt rows. The DP splitter hands rank ``d`` the ``d``-th
+contiguous slice and the actor cuts each rank's slice into S consecutive optimizer steps, so pairs are
+emitted rank-major / step-minor to make every global step hold exactly its row block.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import torch
+
+from miles.utils.train_data_utils import scheduler_meta_from_samples
+from miles.utils.types import Sample
+
+
+def _dp_size(args) -> int:
+    world = int(args.actor_num_nodes) * int(args.actor_num_gpus_per_node)
+    sp = int(getattr(args, "sequence_parallel_size", 1) or 1)
+    return world // sp
+
+
+def _sample_pairs(args, sample: Sample, output_idx: int) -> list[dict[str, Any]]:
+    traj, env = sample.dit_trajectory, sample.denoising_env
+    if traj is None or traj.timesteps is None or env is None:
+        raise ValueError(f"sample {sample.index} lacks dit_trajectory/denoising_env")
+    sde_idx = (sample.train_metadata or {}).get("sde_step_indices")
+    if not sde_idx:
+        raise ValueError("OPD needs the SDE window (sde_step_indices) of every sample")
+    if traj.latent_step_indices is None:
+        position = {step: step for step in range(int(traj.latents.shape[0]))}
+    else:
+        position = {int(step): pos for pos, step in enumerate(traj.latent_step_indices.tolist())}
+    missing = [int(i) for i in sde_idx if int(i) not in position]
+    if missing:
+        raise ValueError(f"trajectory lacks latents for window steps {missing}")
+    route = sample.metadata.get(args.teacher_key)
+    if route is None:
+        raise ValueError(f"sample {sample.index} has no metadata[{args.teacher_key!r}] to route its teacher")
+    pairs = []
+    for i in sde_idx:
+        i = int(i)
+        pairs.append(
+            {
+                "latent": traj.latents[position[i]].detach().cpu(),  # producer dtype, bytes as returned
+                "timestep": traj.timesteps[i].detach().cpu(),
+                "next_timestep": traj.timesteps[i + 1].detach().cpu(),
+                "denoising_env": env,
+                "teacher_route": str(route),
+                "sample_index": sample.index,
+                "row_id": sample.metadata.get("row_id"),
+                "output_idx": output_idx,
+                "request_id": sample.request_id,
+                "step_index": i,
+                "prompt": sample.prompt,
+            }
+        )
+    return pairs
+
+
+def convert_samples_to_train_data(args, samples: list[Sample]) -> dict[str, Any]:
+    if samples and isinstance(samples[0], list):
+        samples = [s for group in samples for s in group]
+    n = int(args.n_samples_per_prompt)
+    if len(samples) % n:
+        raise ValueError(f"{len(samples)} samples is not a whole number of {n}-sample groups")
+    groups = [samples[g * n : (g + 1) * n] for g in range(len(samples) // n)]
+    for group in groups:
+        if len({s.group_index for s in group}) != 1:
+            raise ValueError("samples of one prompt row must be contiguous")
+
+    steps = int(args.num_steps_per_rollout or 1)
+    dp = _dp_size(args)
+    rows = len(groups)
+    if rows % (steps * dp):
+        raise ValueError(f"{rows} rows per rollout must split evenly over {steps} steps x {dp} DP ranks")
+    per_chunk = rows // (steps * dp)
+
+    def chunk(step: int, rank: int) -> list[list[Sample]]:
+        lo = step * (rows // steps) + rank * per_chunk
+        return groups[lo : lo + per_chunk]
+
+    train_data: list[dict[str, Any]] = []
+    for rank in range(dp):
+        for step in range(steps):
+            for group in chunk(step, rank):
+                for output_idx, sample in enumerate(group):
+                    train_data.extend(_sample_pairs(args, sample, output_idx))
+    return {"train_data": train_data, **scheduler_meta_from_samples(samples)}
+
+
+def pair_dtype(pair: dict[str, Any]) -> torch.dtype:
+    return pair["latent"].dtype
diff --git a/scripts/run_diffusion_opd_sd3_mopd.py b/scripts/run_diffusion_opd_sd3_mopd.py
new file mode 100644
index 00000000..42d924fc
--- /dev/null
+++ b/scripts/run_diffusion_opd_sd3_mopd.py
@@ -0,0 +1,138 @@
+"""SD3.5-medium multi-teacher on-policy distillation (DiffusionOPD / MOPD) on mixed OCR + PickScore prompts.
+
+The student (a LoRA on SD3.5-M) samples its own CPS trajectories on the sglang-diffusion engine; every
+sample is routed by its ``metadata.data_source`` to a frozen teacher (the official DiffusionOPD OCR and
+Aes teachers, quanhaol/DiffusionOPD) that scores the same SDE states; the student minimises the per-step
+closed-form Gaussian KL (element mean, i.e. KL / D) between its and the teacher's transition means.
+Only the student adapter is published back to the engines. Mirrors the verl-omni recipe
+``examples/diffusionopd_trainer/sd35/run_sd35_medium_mopd_distill.sh`` (guidance 1.0, CPS eta 0.8,
+3-step window in [0, 5), LoRA r32/a64, lr 1e-4, wd 1e-4, 8 prompts x 8 samples, 2 optimizer steps per
+rollout, sync), at 512x512 on 2 GPUs.
+
+Prompt rows: jsonl ``{"input": <prompt>, "metadata": {"data_source": "ocr"|"pickscore", "row_id": int}}``.
+
+2-GPU colocate: FSDP DP=2 plus 2 rollout engines time-multiplexed on the same GPUs.
+
+Usage:
+    python3 scripts/run_diffusion_opd_sd3_mopd.py --prompt-data rows.jsonl \\
+        --ocr-teacher <dir>/OCRTeacher/lora --aes-teacher <dir>/AesTeacher/lora
+"""
+
+from dataclasses import dataclass
+
+import typer
+
+import miles.utils.external_utils.command_utils as U
+
+MODEL = "stabilityai/stable-diffusion-3.5-medium"
+
+
+@dataclass
+class ScriptArgs(U.ExecuteTrainConfig):
+    model: str = MODEL
+    prompt_data: str = ""
+    ocr_teacher: str = ""
+    aes_teacher: str = ""
+    ocr_label: str = "ocr"  # data_source value routed to the OCR teacher
+    aes_label: str = "pickscore"  # data_source value routed to the Aes teacher
+    student_init: str = ""
+    num_rollout: int = 48
+    rollout_seed: int = 42
+    train_dtype: str = "fp16"  # task contract: fp16 or fp32 training only (bf16 too far from the fp32 oracle)
+    opd_dump_dir: str = ""
+    rollout_generate_url: str = ""
+    rows_per_round: int = 8
+    steps_per_round: int = 2
+    probe_steps: int = 0  # the first N optimizer steps dump transition means + post-step LoRA
+    extra_args: str = ""
+
+
+def execute(args: ScriptArgs) -> None:
+    run_name = f"diffusion_opd_sd3_mopd_{U.create_run_id()}"
+
+    ckpt_args = f"--hf-checkpoint {args.model} "
+
+    rollout_args = (
+        "--rollout-function-path miles.rollout.sglang_diffusion_rollout.generate_rollout "
+        f"--prompt-data {args.prompt_data} "
+        "--input-key input "
+        "--metadata-key metadata "
+        f"--rollout-batch-size {args.rows_per_round} "
+        "--n-samples-per-prompt 8 "
+        f"--num-rollout {args.num_rollout} "
+        f"--rollout-seed {args.rollout_seed} "
+        f"--num-steps-per-rollout {args.steps_per_round} "
+        "--rollout-microgroup-size 8 "
+        "--diffusion-num-steps 10 "
+        "--diffusion-guidance-scale 1.0 "
+        "--diffusion-sde-type cps "
+        "--sde-step-backend-path miles.backends.fsdp_utils.sde_step_backend.CpsSdeStepBackend "
+        "--diffusion-noise-level 0.8 "
+        "--diffusion-log-prob-no-const "
+        "--diffusion-height 512 "
+        "--diffusion-width 512 "
+        "--diffusion-step-strategy-path miles.rollout.step_strategy_hub.sde_window "
+        "--diffusion-num-sde-steps 3 "
+        "--diffusion-sde-window-range 0,5 "
+    )
+    if args.rollout_generate_url:
+        rollout_args += f"--rollout-generate-url {args.rollout_generate_url} "
+
+    opd_args = (
+        "--loss-type opd "
+        f"--teacher-model {args.ocr_label}={args.ocr_teacher} "
+        f"--teacher-model {args.aes_label}={args.aes_teacher} "
+        "--teacher-key data_source "
+    )
+    if args.student_init:
+        opd_args += f"--student-init {args.student_init} "
+    if args.opd_dump_dir:
+        opd_args += f"--opd-dump-dir {args.opd_dump_dir} "
+    if args.probe_steps:
+        opd_args += f"--opd-dump-means-steps {args.probe_steps} "
+
+    optimizer_args = "--lr 1e-4 --adam-beta1 0.9 --adam-beta2 0.999 --adam-eps 1e-8 --weight-decay 1e-4 --clip-grad 1.0 "
+
+    lora_args = "--use-lora --lora-ipc-weight-sync --lora-rank 32 --lora-alpha 64 --lora-init-weights gaussian "
+
+    sglang_args = (
+        "--use-miles-router "
+        "--rollout-parser-num-workers 16 "
+        "--sglang-server-concurrency 8 "
+        "--sglang-dit-precision fp16 "
+        "--sglang-vae-slicing "
+        "--update-weight-buffer-size 2147483648 "
+    )
+
+    train_backend_args = f"--train-backend fsdp --diffusion-forward-dtype {args.train_dtype} "
+
+    perf_args = f"--gradient-checkpointing --micro-batch-size {16 if args.rows_per_round % 8 == 0 else 8} "
+
+    misc_args = (
+        "--actor-num-gpus-per-node 2 "
+        "--rollout-num-gpus 2 "
+        "--rollout-num-gpus-per-engine 1 "
+        "--num-gpus-per-node 2 "
+        "--colocate "
+    )
+
+    U.execute_train(
+        train_args=(
+            f"{ckpt_args} {rollout_args} {opd_args} {optimizer_args} {lora_args} {sglang_args} "
+            f"{train_backend_args} {perf_args} {misc_args} {args.extra_args}"
+        ),
+        num_gpus_per_node=2,
+        config=args,
+        # No expandable segments: their CUDA-IPC export needs pidfd_getfd, which sandboxed containers deny.
+        extra_env_vars={},
+    )
+    print(f"run {run_name} done")
+
+
+@U.dataclass_cli
+def main(args: ScriptArgs) -> None:
+    execute(args)
+
+
+if __name__ == "__main__":
+    typer.run(main)
