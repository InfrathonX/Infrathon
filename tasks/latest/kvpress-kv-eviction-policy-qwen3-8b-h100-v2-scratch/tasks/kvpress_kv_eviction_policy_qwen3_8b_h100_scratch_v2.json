  "work": {
    "image_tag": "local",
    "specs_dir": "/app/workdir/kv_eviction_lab",
    "cpu_limit": 8,
    "mem_limit": "32g",
    "agent_query": "Read AGENT_TASK.md and README_AGENT.md first. Starting from the supplied position-only baseline, design a KV eviction policy for frozen Qwen3-8B at 50%, 75%, and 87.5% eviction that preserves the full-cache next-token behaviour on long-context retrieval, aggregation, question-answering and generation items. Keep versioned policy_vNNN candidates, preserve every fail-closed gate, and leave FINAL_VERSION on the strongest clean candidate. Policies must not use token identity in any form (see AGENT_TASK.md). Use the one, quick, and full public commands for iteration. Every sforge-submit --details evaluates the complete frozen private suite on separate Judge GPUs and waits for the result, which takes on the order of an hour; the archive at the deadline is evaluated again on the same suite after Work ends."
  },
  "judge": {
    "image_tag": "local",
    "eval_cmd": "python3 /opt/kvpress_kv_eviction_judge/run_judge.py --app-dir /app --log-dir /logs/verifier",
    "eval_timeout": 11000,
    "parser": "structured_json",
    "private_artifact_path": "/logs/verifier/kvpress_kv_eviction_v2_private.json.gz",
    "score_direction": "maximize",
    "selection": "valid_then_score",
    "cpu_limit": 64,
    "mem_limit": "96g"
  },
  "portable": {
    "schema_version": 1,
    "task_core": {
      "contract_id": "kvpress-kv-eviction-policy-v2",
      "definition": {
        "operation": "kv_cache_eviction_policy_for_frozen_decoder",
        "model_id": "Qwen/Qwen3-8B",
        "n_layers": 36,
        "n_heads": 32,
        "n_kv_heads": 8,
        "head_dim": 128,
        "hidden_size": 4096,
        "families": [
          "retrieval",
          "aggregation",
          "qa",
          "generation"
        ],
        "min_keep": 64,
        "sink_floor": 4,
        "reference_tokens": {
          "min": 16,
          "max": 48
        },
        "context_tokens": {
          "min": 1024,
          "max": 28672,
          "final_min": 6144
        },
        "item_sources": [
          "simonjegou/ruler",
          "Xnhyacinth/LongBench",
          "simonjegou/loogle",
          "simonjegou/zero_scrolls"
        ],
        "ratios_per_mille": [
          500,
          750,
          875
        ]
      },
      "interface": {
        "entry_point": "EvictionPolicy(spec, compression_ratio, assets).select(layer_idx, hidden_states, queries, keys, values, position_embeddings, weights, n_kept) -> int64[1,8,n_kept]",
        "optional": "layer_budgets(seq_len, n_kept_total) -> list[int] | None",
        "source_path": "candidates/policy_vNNN/submission.py",
        "assets_path": "candidates/policy_vNNN/assets.pt",
        "version_selector": "FINAL_VERSION",
        "implementation_surface": "python_torch_source_with_static_admission"
      },
      "allowed_changes": [
        "versioned policy implementations under candidates",
        "optional assets.pt tensors (weights_only, at most 64 MiB)",
        "FINAL_VERSION selector",
        "notes.md"
      ],
      "invariants": [
        "the model, context-only capture, compression ratios and trusted replay are frozen",
        "Phase A (unprivileged worker, context only) emits validated indices only; Phase B (trusted) replays them with question + answer prefix without candidate code",
        "a fresh policy instance per item and ratio; every select call receives freshly copied inputs",
        "fidelity = exp(-mean token KL(full || compressed)); family mean, ratio geomean over four families, primary = 100 x mean over ratios",
        "every run-wide gate is fail-closed: admitted source, valid unique indices, conserved layer budgets, immutable inputs and RNG, suite latency <= 30% and item latency <= 60% of trusted plain prefill, policy memory <= 8 GiB, finite fidelity with >= 16 reference tokens",
        "every scored round evaluates the frozen 5,000-item final suite (full-final-shared-v2); its manifest is Judge-only and its items are rebuilt from pinned public datasets at image build",
        "the Judge shards items across 1-8 identical GPUs; per-item computation and the score do not depend on the shard count"
      ],
      "resource_manifest_sha256": "sha256:dc0512a677fa9de17460cf8c8cf775d9eb3621c68c22a3cac2a89d48a0098004"
    },
