# Private Judge layer: the public Judge plus the private holdout.  Built only on
# the host that runs the task, never published; the files come from the
# Judge-only build context scripts/build_images.sh stages.
ARG JUDGE_PUBLIC_IMAGE
FROM ${JUDGE_PUBLIC_IMAGE}
COPY --from=final_items final_manifest.json final_items.jsonl.gz /opt/kvpress_kv_eviction_judge/private/
RUN chown -R root:root /opt/kvpress_kv_eviction_judge/private \
 && chmod 0500 /opt/kvpress_kv_eviction_judge/private \
 && chmod 0400 /opt/kvpress_kv_eviction_judge/private/final_manifest.json /opt/kvpress_kv_eviction_judge/private/final_items.jsonl.gz
