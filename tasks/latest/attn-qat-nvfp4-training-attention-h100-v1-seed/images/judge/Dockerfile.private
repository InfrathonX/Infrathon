# Private Judge layer: the public Judge plus the Judge-only inputs.
# Built only on the host that runs the task, never published; the inputs come
# from the Judge-only build context scripts/build_images.sh stages.
ARG JUDGE_PUBLIC_IMAGE
FROM ${JUDGE_PUBLIC_IMAGE}

COPY --from=final_cases final_cases.json /opt/attn_qat_judge/private/

RUN chown -R root:root /opt/attn_qat_judge/private \
    && chmod 0500 /opt/attn_qat_judge/private \
    && chmod 0400 /opt/attn_qat_judge/private/final_cases.json
