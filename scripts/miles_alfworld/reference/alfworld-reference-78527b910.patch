@@ -0,0 +1,134 @@
+#!/bin/bash
+# ALFWorld agentic GRPO reference run: Qwen3-4B, two GPUs (GPU0 = Megatron trainer,
+# GPU1 = SGLang rollout engine). Episodes run through the session server (TITO), so
+# the trained tokens are exactly the tokens the engine produced.
+#
+# Environment (container): MILES=/workspace/miles, ASSETS=/assets, SCRATCH=/scratch,
+# POLICY_HF=<HF snapshot dir>, POLICY_MEGATRON=<torch_dist dir>, DATA=<train jsonl>.
+set -euxo pipefail
+
+MILES=${MILES:-/workspace/miles}
+ASSETS=${ASSETS:-/assets}
+SCRATCH=${SCRATCH:-/scratch}
+RUN_NAME=${RUN_NAME:-alfworld-dev}
+NUM_ROLLOUT=${NUM_ROLLOUT:-4}
+ROLLOUT_BATCH=${ROLLOUT_BATCH:-16}
+N_SAMPLES=${N_SAMPLES:-8}
+MAX_TURN_TOKENS=${MAX_TURN_TOKENS:-256}
+MAX_SEQ_LEN=${MAX_SEQ_LEN:-24576}
+LR=${LR:-1e-6}
+SAVE_INTERVAL=${SAVE_INTERVAL:-1000}
+SEED=${SEED:-1234}
+TRAIN_SCRIPT=${TRAIN_SCRIPT:-train.py}
+EXTRA_ARGS=${EXTRA_ARGS:-}
+export ALFWORLD_DATA=${ALFWORLD_DATA:-${ASSETS}/alfworld_data}
+export ALFWORLD_ENV_WORKERS=${ALFWORLD_ENV_WORKERS:-32}
+
+export PYTHONUNBUFFERED=1
+ALFWORLD_SITE=${ALFWORLD_SITE:-${ASSETS}/venv/lib/python3.12/site-packages}
+export PYTHONPATH=${MILES}:/root/Megatron-LM:${MILES}/examples/alfworld:${ALFWORLD_SITE}
+cd "${MILES}"
+
+MODEL_ARGS_LINE="$(python3 miles/utils/external_utils/model_args_utils.py qwen3-4B)"
+read -ra MODEL_ARGS <<< "${MODEL_ARGS_LINE}"
+
+CKPT_ARGS=(
+   --hf-checkpoint "${POLICY_HF}"
+   --ref-load "${POLICY_MEGATRON}"
+   --load "${SCRATCH}/${RUN_NAME}/checkpoints"
+   --save "${SCRATCH}/${RUN_NAME}/checkpoints"
+   --save-interval "${SAVE_INTERVAL}"
+)
+
+ROLLOUT_ARGS=(
+   --prompt-data "${DATA}"
+   --input-key prompt
+   --metadata-key metadata
+   --apply-chat-template-kwargs '{"enable_thinking": false}'
+   --num-rollout "${NUM_ROLLOUT}"
+   --rollout-batch-size "${ROLLOUT_BATCH}"
+   --n-samples-per-prompt "${N_SAMPLES}"
+   --rollout-max-response-len "${MAX_TURN_TOKENS}"
+   --rollout-temperature 1
+   --rollout-top-p 1
+   --seed "${SEED}"
+   --global-batch-size $((ROLLOUT_BATCH * N_SAMPLES))
+)
+
+AGENT_ARGS=(
+   --custom-generate-function-path miles.rollout.generate_hub.agentic_tool_call.generate
+   --custom-agent-function-path alfworld_agent.run
+   --custom-rm-path alfworld_agent.reward_func
+   --dynamic-sampling-filter-path miles.rollout.filter_hub.dynamic_sampling_filters.check_no_aborted
+   --use-session-server
+   --session-server-ip 127.0.0.1
+   --session-server-port 30100
+   --tito-model qwen3
+   --max-seq-len "${MAX_SEQ_LEN}"
+)
+
+GRPO_ARGS=(
+   --advantage-estimator grpo
+   --calculate-per-token-loss
+   --eps-clip 0.2
+   --eps-clip-high 0.28
+   --kl-coef 0.0
+   --entropy-coef 0.0
+)
+
+OPTIMIZER_ARGS=(
+   --optimizer adam
+   --lr "${LR}"
+   --lr-decay-style constant
+   --weight-decay 0.01
+   --adam-beta1 0.9
+   --adam-beta2 0.999
+   --adam-eps 1e-8
+   --clip-grad 1.0
+)
+
+PERF_ARGS=(
+   --tensor-model-parallel-size 1
+   --pipeline-model-parallel-size 1
+   --context-parallel-size 1
+   --recompute-granularity full
+   --recompute-method uniform
+   --recompute-num-layers 1
+   --use-dynamic-batch-size
+   --max-tokens-per-gpu "${MAX_SEQ_LEN}"
+)
+
+SGLANG_ARGS=(
+   --rollout-num-gpus-per-engine 1
+   --sglang-mem-fraction-static 0.8
+)
+
+MISC_ARGS=(
+   --attention-dropout 0.0
+   --hidden-dropout 0.0
+   --accumulate-allreduce-grads-in-fp32
+   --attention-softmax-in-fp32
+   --attention-backend flash
+)
+
+export MASTER_ADDR=${MASTER_ADDR:-"127.0.0.1"}
+ray start --head --node-ip-address "${MASTER_ADDR}" --num-gpus 2 --disable-usage-stats --dashboard-host=0.0.0.0 --dashboard-port=8265
+
+ray job submit --address="http://127.0.0.1:8265" \
+   --runtime-env-json="{\"env_vars\": {\"PYTHONPATH\": \"${PYTHONPATH}\", \"CUDA_DEVICE_MAX_CONNECTIONS\": \"1\", \"ALFWORLD_DATA\": \"${ALFWORLD_DATA}\", \"ALFWORLD_ENV_WORKERS\": \"${ALFWORLD_ENV_WORKERS}\"}}" \
+   -- python3 "${TRAIN_SCRIPT}" \
+   --actor-num-nodes 1 \
+   --actor-num-gpus-per-node 1 \
+   --rollout-num-gpus 1 \
+   "${MODEL_ARGS[@]}" \
+   "${CKPT_ARGS[@]}" \
+   "${ROLLOUT_ARGS[@]}" \
+   "${AGENT_ARGS[@]}" \
+   "${GRPO_ARGS[@]}" \
+   "${OPTIMIZER_ARGS[@]}" \
+   "${PERF_ARGS[@]}" \
+   "${SGLANG_ARGS[@]}" \
+   "${MISC_ARGS[@]}" \
+   ${EXTRA_ARGS}
+
+ray stop --force
