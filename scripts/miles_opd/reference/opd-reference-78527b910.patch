+#!/bin/bash
+# Oracle run for the OPD-from-scratch task: unmodified upstream Miles OPD
+# (sampled-token reverse KL, --opd-type sglang, K=0). Qwen3-1.7B student,
+# frozen Qwen3-4B teacher served by a separate SGLang server. Two GPUs:
+# Megatron trainer + student SGLang engine; the teacher server shares GPU0.
+#
+# Environment (container): MILES=/workspace/miles, SCRATCH=/scratch,
+# STUDENT_HF, TEACHER_HF, STUDENT_MEGATRON, DATA=<dir with train.jsonl>.
+set -euxo pipefail
+
+MILES=${MILES:-/workspace/miles}
+SCRATCH=${SCRATCH:-/scratch}
+RUN_NAME=${RUN_NAME:-opd-oracle-dev}
+NUM_ROLLOUT=${NUM_ROLLOUT:-8}
+ROLLOUT_BATCH=${ROLLOUT_BATCH:-32}
+N_SAMPLES=${N_SAMPLES:-1}
+MAX_RESP=${MAX_RESP:-512}
+LR=${LR:-5e-6}
+OPD_KL_COEF=${OPD_KL_COEF:-1.0}
+SAVE_INTERVAL=${SAVE_INTERVAL:-1000000}
+SEED=${SEED:-1234}
+TEACHER_PORT=${TEACHER_PORT:-30010}
+TEACHER_MEM=${TEACHER_MEM:-0.15}
+STUDENT_MEM=${STUDENT_MEM:-0.5}
+TRAIN_SCRIPT=${TRAIN_SCRIPT:-train.py}
+# 0 = round r trains on lines [r*B, (r+1)*B) of the training file (the task contract)
+ROLLOUT_SHUFFLE=${ROLLOUT_SHUFFLE:-0}
+EXTRA_ARGS=${EXTRA_ARGS:-}
+
+export PYTHONUNBUFFERED=1
+export PYTHONPATH=${MILES}:/root/Megatron-LM
+cd "${MILES}"
+mkdir -p "${SCRATCH}/${RUN_NAME}"
+
+CUDA_VISIBLE_DEVICES=0 python3 -m sglang.launch_server \
+   --model-path "${TEACHER_HF}" \
+   --host 127.0.0.1 --port "${TEACHER_PORT}" \
+   --tp 1 --mem-fraction-static "${TEACHER_MEM}" \
+   > "${SCRATCH}/${RUN_NAME}/teacher_server.log" 2>&1 &
+TEACHER_PID=$!
+trap 'kill ${TEACHER_PID} 2>/dev/null || true; ray stop --force || true' EXIT
+until curl -sf "http://127.0.0.1:${TEACHER_PORT}/health_generate" > /dev/null; do
+   kill -0 ${TEACHER_PID} || { tail -50 "${SCRATCH}/${RUN_NAME}/teacher_server.log"; exit 1; }
+   sleep 5
+done
+
+MODEL_ARGS_LINE="$(python3 miles/utils/external_utils/model_args_utils.py qwen3-1.7B)"
+read -ra MODEL_ARGS <<< "${MODEL_ARGS_LINE}"
+
+CKPT_ARGS=(
+   --hf-checkpoint "${STUDENT_HF}"
+   --ref-load "${STUDENT_MEGATRON}"
+   --load "${SCRATCH}/${RUN_NAME}/checkpoints"
+   --save "${SCRATCH}/${RUN_NAME}/checkpoints"
+   --save-interval "${SAVE_INTERVAL}"
+)
+
+ROLLOUT_ARGS=(
+   --prompt-data "${DATA}/train.jsonl"
+   --input-key content
+   --label-key answer
+   --apply-chat-template
+   --apply-chat-template-kwargs '{"enable_thinking": false}'
+   --num-rollout "${NUM_ROLLOUT}"
+   --rollout-batch-size "${ROLLOUT_BATCH}"
+   --n-samples-per-prompt "${N_SAMPLES}"
+   --rollout-max-response-len "${MAX_RESP}"
+   --rollout-temperature 1
+   --rollout-top-p 1
+   --seed "${SEED}"
+   --global-batch-size $((ROLLOUT_BATCH * N_SAMPLES))
+)
+if [ "${ROLLOUT_SHUFFLE}" = "1" ]; then ROLLOUT_ARGS+=(--rollout-shuffle); fi
+
+RM_ARGS=(
+   --custom-rm-path miles.rollout.on_policy_distillation.reward_func
+   --custom-reward-post-process-path miles.rollout.on_policy_distillation.post_process_rewards
+   --rm-url "http://127.0.0.1:${TEACHER_PORT}/generate"
+)
+
+OPD_ARGS=(
+   --advantage-estimator grpo
+   --use-opd
+   --opd-type sglang
+   --opd-kl-coef "${OPD_KL_COEF}"
+   --opd-log-prob-top-k 0
+   --kl-coef 0.0
+   --entropy-coef 0.0
+)
+
+OPTIMIZER_ARGS=(
+   --optimizer adam
+   --lr "${LR}"
+   --lr-decay-style constant
+   --weight-decay 0.01
+   --adam-beta1 0.9
+   --adam-beta2 0.999
+   --adam-eps 1e-8
+   --clip-grad 1.0
+)
+
+PERF_ARGS=(
+   --tensor-model-parallel-size 1
+   --pipeline-model-parallel-size 1
+   --context-parallel-size 1
+   --recompute-granularity full
+   --recompute-method uniform
+   --recompute-num-layers 1
+   --use-dynamic-batch-size
+   --max-tokens-per-gpu 16384
+)
+
+SGLANG_ARGS=(
+   --rollout-num-gpus-per-engine 1
+   --sglang-mem-fraction-static "${STUDENT_MEM}"
+)
+
+MISC_ARGS=(
+   --attention-dropout 0.0
+   --hidden-dropout 0.0
+   --accumulate-allreduce-grads-in-fp32
+   --attention-softmax-in-fp32
+   --attention-backend flash
+)
+
+export MASTER_ADDR=${MASTER_ADDR:-"127.0.0.1"}
+ray start --head --node-ip-address "${MASTER_ADDR}" --num-gpus 2 --disable-usage-stats --dashboard-host=0.0.0.0 --dashboard-port=8265
+
+ray job submit --address="http://127.0.0.1:8265" \
+   --runtime-env-json="{\"env_vars\": {\"PYTHONPATH\": \"${MILES}:/root/Megatron-LM/\", \"CUDA_DEVICE_MAX_CONNECTIONS\": \"1\"}}" \
+   -- python3 "${TRAIN_SCRIPT}" \
+   --actor-num-nodes 1 \
+   --actor-num-gpus-per-node 1 \
+   --rollout-num-gpus 1 \
+   "${MODEL_ARGS[@]}" \
+   "${CKPT_ARGS[@]}" \
+   "${ROLLOUT_ARGS[@]}" \
+   "${RM_ARGS[@]}" \
+   "${OPD_ARGS[@]}" \
+   "${OPTIMIZER_ARGS[@]}" \
+   "${PERF_ARGS[@]}" \
+   "${SGLANG_ARGS[@]}" \
+   "${MISC_ARGS[@]}" \
+   ${EXTRA_ARGS}
