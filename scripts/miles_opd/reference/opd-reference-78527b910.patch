@@ -0,0 +1,59 @@
+"""Per-step training record required by the OPD-from-scratch task contract.
+
+Not part of upstream Miles: the task's reference is upstream on-policy distillation
+(sampled-token, ``--opd-type sglang``, K=0) plus this writer. One file per data-parallel
+rank, ``{OPD_STEP_DUMP_DIR}/step_{k:03d}_rank_{dp}.pt``, holding what that rank trained on.
+"""
+
+import os
+from argparse import Namespace
+from pathlib import Path
+
+import torch
+import torch.distributed as dist
+
+from miles.backends.training_utils.parallel import get_parallel_state
+from miles.utils.types import RolloutBatch
+
+
+def _cpu(xs):
+    return [x.detach().float().cpu() if torch.is_tensor(x) else torch.as_tensor(x) for x in xs]
+
+
+def write_step_dump(args: Namespace, rollout_id: int, rollout_data: RolloutBatch) -> None:
+    out = os.environ.get("OPD_STEP_DUMP_DIR")
+    if not out:
+        return
+    ps = get_parallel_state()
+    if ps.cp.size != 1:
+        raise NotImplementedError("the reference step dump assumes context parallel size 1")
+    old = rollout_data["log_probs"]
+    teacher = rollout_data["teacher_log_probs"]
+    masks = rollout_data["loss_masks"]
+    # Objective at the pre-update weights: per-sequence token mean of (log p_old - log p_teacher),
+    # averaged over every sequence of the step (all DP ranks).
+    per_seq = [
+        float(((o.float().cpu() - t.float().cpu()) * m.float().cpu()).sum() / m.float().sum().clamp_min(1).cpu())
+        for o, t, m in zip(old, teacher, masks, strict=True)
+    ]
+    totals = torch.tensor([sum(per_seq), len(per_seq)], dtype=torch.float64, device=torch.cuda.current_device())
+    if ps.intra_dp.size > 1:
+        dist.all_reduce(totals, group=ps.intra_dp.group)
+    if ps.tp.rank != 0 or not ps.is_pp_last_stage:
+        return
+    record = {
+        "step": rollout_id,
+        "loss": float(totals[0] / totals[1].clamp_min(1)),
+        "num_sequences": int(totals[1]),
+        "tokens": [torch.as_tensor(t, dtype=torch.int64).cpu() for t in rollout_data["tokens"]],
+        "response_lengths": [int(r) for r in rollout_data["response_lengths"]],
+        "loss_masks": [torch.as_tensor(m).cpu() for m in masks],
+        "old_logprobs": _cpu(old),
+        "teacher_logprobs": _cpu(teacher),
+        "advantages": _cpu(rollout_data["advantages"]),
+    }
+    path = Path(out) / f"step_{rollout_id:03d}_rank_{ps.intra_dp.rank}.pt"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_suffix(".tmp")
+    torch.save(record, tmp)
+    tmp.replace(path)
